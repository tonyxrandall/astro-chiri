---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { normalizeTags } from "@/utils/tags";
const { frontmatter } = Astro.props;
const tags = normalizeTags(frontmatter.tags);
const imageAlt = frontmatter.image?.alt?.trim() || frontmatter.title;
---

<BaseLayout
  title={`${frontmatter.title} — The B-Side`}
  description={frontmatter.description}
>
  <section>
    <div class="py-24">
      <div class="max-w-xl">
        <h1 class="text-4xl font-medium font-display text-base-900 text-balance leading-tight">
          {frontmatter.title}
        </h1>
        <p class="mt-4 text-sm text-base-500 text-balance">
          <em>{frontmatter.description}</em>
        </p>
      </div>
      {
        frontmatter.image && (
          <img
            src={frontmatter.image.url}
            alt={imageAlt}
            class="object-contain bg-base-50 object-center w-full aspect-12/7 rounded-xl mt-6"
          />
        )
      }
      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs">
        <p class="text-zinc-500">
          {frontmatter.pubDate.toString().slice(0, 10)} — {frontmatter.author}
        </p>
        {tags.length > 0 && <span class="text-base-300" aria-hidden="true">•</span>}
        <div class="flex flex-wrap gap-x-3 gap-y-2">
          {
            tags.map((tag) => (
              <span class="font-medium text-base-600 hover:text-blue-500">
                <a href={`/tags/${tag}`}>{tag}</a>
              </span>
            ))
          }
        </div>
      </div>
      <div class="prose prose-sm max-w-none mt-12">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>
