<section class="bg-base-50 p-8 rounded-xl lg:p-16 my-16">
  <h2 class="text-2xl font-medium font-display text-base-900 text-center text-balance">
    Get the B-Side perspective in your inbox.
  </h2>
  <p class="mt-3 text-sm text-base-500 text-center max-w-sm mx-auto leading-relaxed">
    Linkbuilding ideas, strategy notes, and campaigns worth stealing. No fluff.
  </p>
  <form
    action=""
    method="post"
    class="mt-8"
    aria-label="Newsletter signup form"
  >
    <div class="flex flex-col w-full max-w-md mx-auto gap-3 sm:flex-row">
      <label for="email" class="sr-only">Email address</label>
      <input
        id="email"
        name="email"
        type="email"
        class="block w-full h-10 px-4 py-2 text-sm rounded-full border border-base-200 text-base-900 placeholder-base-400 focus:border-base-400 focus:outline-none focus:ring-2 focus:ring-base-200 bg-white"
        placeholder="Enter your email..."
        required
      />
      <button
        type="submit"
        class="flex items-center justify-center h-10 px-5 py-2 text-sm text-white bg-base-900 rounded-full hover:bg-base-700 transition-colors duration-150 font-medium whitespace-nowrap"
      >
        Subscribe
      </button>
    </div>
  </form>
</section>
