---
import { getCollection } from "astro:content";

const settingsEntries = await getCollection("settings");
const navEntry = settingsEntries.find((e) => e.id === "navigation");
const nav = navEntry?.data;

const siteName = nav?.siteName ?? "The B-Side";
const navLinks = nav?.navLinks ?? [];
const ctaText = nav?.ctaText ?? "Book a Call";
const ctaUrl = nav?.ctaUrl ?? "/about#contact";
const socialLinks = nav?.socialLinks ?? [];

const socialIconSvgs: Record<string, string> = {
  linkedin: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M6.94 8.5H3.56V19h3.38V8.5zM5.25 7.03a1.96 1.96 0 100-3.92 1.96 1.96 0 000 3.92zM20.44 13.07c0-3.17-1.69-4.64-3.95-4.64-1.82 0-2.64 1-3.1 1.7V8.5H10v10.5h3.38v-5.2c0-1.37.26-2.7 1.96-2.7 1.67 0 1.7 1.56 1.7 2.79V19h3.4l-.01-5.93z"/></svg>`,
  twitter: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.847h-7.406l-5.8-7.584-6.64 7.584H.47l8.6-9.83L0 1.154h7.594l5.243 6.932L18.9 1.153zm-1.29 19.494h2.04L6.486 3.24H4.298L17.61 20.647z"/></svg>`,
};
---

<div
  x-data="{ open: false }"
  class="relative flex flex-col w-full mx-auto md:items-center md:justify-between md:flex-row"
>
  <div class="flex flex-row items-center justify-between py-4 md:justify-start">
    <a class="text-base font-semibold tracking-tight text-base-900" href="/">
      {siteName}
    </a>
    <button
      @click="open = !open"
      class="inline-flex items-center justify-center p-2 text-base-900 hover:text-blue-500 focus:outline-none md:hidden"
      aria-label="Toggle menu"
    >
      <svg class="w-5 h-5" stroke="currentColor" fill="none" viewBox="0 0 24 24">
        <path
          :class="{'hidden': open, 'inline-flex': !open }"
          class="inline-flex"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"
        ></path>
        <path
          :class="{'hidden': !open, 'inline-flex': open }"
          class="hidden"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"
        ></path>
      </svg>
    </button>
  </div>

  <nav
    :class="{'flex': open, 'hidden': !open}"
    class="flex-col justify-center flex-grow hidden pb-6 md:pb-0 md:flex md:items-center md:flex-row"
  >
    <div class="items-center list-none space-y-2 md:space-y-0 md:ml-auto md:inline-flex gap-6">
      {
        navLinks.map((link) => (
          <a
            href={link.url}
            class="text-base-600 hover:text-base-900 text-sm font-medium transition-colors duration-150"
          >
            {link.label}
          </a>
        ))
      }
      {socialLinks.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noreferrer noopener"
          aria-label={link.label}
          class="text-base-500 hover:text-base-900 transition-colors duration-150"
        >
          <Fragment set:html={socialIconSvgs[link.icon ?? ""] ?? socialIconSvgs[link.label.toLowerCase()] ?? ""} />
        </a>
      ))}
      <a
        href={ctaUrl}
        class="py-1.5 px-4 text-sm rounded-full bg-base-900 text-white hover:bg-base-700 transition-colors duration-150 font-medium"
      >
        {ctaText}
      </a>
    </div>
  </nav>
</div>
