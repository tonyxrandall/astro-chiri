---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const pagesEntries = await getCollection("pages");
const aboutPage = pagesEntries.find((e) => e.id === "about");
const data = aboutPage?.data;

const hero = data?.hero;
const contact = data?.contact;
const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
---

<BaseLayout
  title={data?.title ? `${data.title} — The B-Side` : "About — The B-Side"}
  description={data?.description ?? "Learn about The B-Side linkbuilding consultancy."}
>
  <!-- About Hero -->
  {hero && (
    <section class="py-24 md:py-32">
      <div class="md:grid md:grid-cols-2 md:gap-16 items-start">
        <div class="order-2 md:order-1">
          {hero.eyebrow && (
            <p class="text-xs font-semibold text-blue-500 uppercase tracking-widest mb-3">{hero.eyebrow}</p>
          )}
          <h1 class="text-4xl md:text-5xl font-medium font-display text-base-900 text-balance leading-tight mb-8">
            {hero.heading}
          </h1>
          <div class="prose prose-sm max-w-none text-base-600 leading-relaxed space-y-5">
            <Fragment set:html={hero.body?.replace(/\n\n/g, '</p><p>').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/^/, '<p>').replace(/$/, '</p>')} />
          </div>
        </div>
        <div class="order-1 md:order-2 mb-12 md:mb-0">
          {hero.image ? (
            <img
              src={hero.image}
              alt={hero.imageAlt ?? hero.heading}
              class="w-full aspect-[3/4] object-cover rounded-xl"
            />
          ) : (
            <div class="w-full aspect-[3/4] rounded-xl bg-base-50 border border-base-100 flex items-center justify-center">
              <div class="text-center p-8">
                <p class="text-xs text-base-400">Add your image via Pages CMS</p>
              </div>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Contact Form -->
  {contact && (
    <section id="contact" class="py-20 border-t border-base-100 scroll-mt-16 mb-16">
      <div class="max-w-xl mx-auto text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-medium font-display text-base-900 mb-4">
          {contact.heading}
        </h2>
        <p class="text-sm text-base-500 leading-relaxed">{contact.subtext}</p>
      </div>
      <form
        name="contact"
        method="POST"
        class="max-w-lg mx-auto space-y-4"
        action="https://api.web3forms.com/submit"
      >
        <input type="hidden" name="access_key" value={web3formsAccessKey} />
        <input type="hidden" name="subject" value="New contact form submission from The B-Side" />
        <input type="hidden" name="from_name" value="The B-Side Contact Form" />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
        <div>
          <label for="name" class="block text-xs font-medium text-base-700 mb-1.5">Name</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            placeholder="Your name"
            class="block w-full h-10 px-4 py-2 text-sm rounded-lg border border-base-200 text-base-900 placeholder-base-400 focus:border-base-400 focus:outline-none focus:ring-2 focus:ring-base-200 bg-white"
          />
        </div>
        <div>
          <label for="email" class="block text-xs font-medium text-base-700 mb-1.5">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            placeholder="your@email.com"
            class="block w-full h-10 px-4 py-2 text-sm rounded-lg border border-base-200 text-base-900 placeholder-base-400 focus:border-base-400 focus:outline-none focus:ring-2 focus:ring-base-200 bg-white"
          />
        </div>
        <div>
          <label for="message" class="block text-xs font-medium text-base-700 mb-1.5">Message</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            placeholder="Tell us about your project..."
            class="block w-full px-4 py-3 text-sm rounded-lg border border-base-200 text-base-900 placeholder-base-400 focus:border-base-400 focus:outline-none focus:ring-2 focus:ring-base-200 bg-white resize-none"
          ></textarea>
        </div>
        <button
          type="submit"
          class="w-full py-2.5 px-5 text-sm rounded-full bg-base-900 text-white hover:bg-base-700 transition-colors duration-150 font-medium"
        >
          Send message
        </button>
      </form>
    </section>
  )}
</BaseLayout>
