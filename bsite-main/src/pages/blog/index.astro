---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogEntries from "@/components/entries/BlogEntry.astro";
import { getCollection, getEntry } from "astro:content";
import { normalizeTags } from "@/utils/tags";
import { byNewestPubDate, getPostImageAlt, isPublishedPost } from "@/utils/posts";

const blogPage = await getEntry("pages", "blog");
const allPosts = await getCollection("posts", isPublishedPost);
const tags = [...new Set(allPosts.flatMap((post) => normalizeTags(post.data.tags)))];
const sortedPosts = allPosts.sort(byNewestPubDate);

const pageTitle = blogPage?.data.title ?? "Blog — The B-Side";
const pageDescription =
  blogPage?.data.description ??
  "Linkbuilding insights, strategy, and case studies from The B-Side.";
const heroHeading = blogPage?.data.hero?.heading ?? "From the B-Side";
const heroSubtext =
  blogPage?.data.hero?.subtext ??
  "Linkbuilding insights, strategy, and ideas no one else is trying.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section>
    <div class="py-24">
      <h1 class="text-4xl font-medium font-display text-base-900 max-w-xl text-balance">
        {heroHeading}
      </h1>
      <p class="mt-3 text-sm text-base-500 max-w-md leading-relaxed">
        {heroSubtext}
      </p>
      <div class="flex flex-wrap gap-3 mt-6">
        {
          tags.map((tag) => (
            <a
              class="hover:text-blue-500 text-xs font-medium text-base-600"
              href={`/tags/${tag}`}
            >
              {tag}
            </a>
          ))
        }
      </div>
      <div class="grid grid-cols-1 mt-8 gap-8 gap-y-16 sm:grid-cols-2">
        {
          sortedPosts.map((post) => (
            <BlogEntries
              url={"/blog/" + post.id}
              alt={getPostImageAlt(post)}
              tags={post.data.tags}
              title={post.data.title}
              author={post.data.author}
              image={post.data.image?.url}
              description={post.data.description}
              pubDate={post.data.pubDate.toString().slice(0, 10)}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
