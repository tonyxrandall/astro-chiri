---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found — The B-Side" description="This page does not exist.">
  <section class="py-32 text-center">
    <h1 class="text-6xl font-medium font-display text-base-900">404</h1>
    <p class="mt-4 text-base text-base-500">This page doesn't exist.</p>
    <a
      href="/"
      class="mt-8 inline-flex py-2 px-5 text-sm rounded-full bg-base-900 text-white hover:bg-base-700 transition-colors duration-150 font-medium"
    >
      Go home
    </a>
  </section>
</BaseLayout>
