---
import { type CollectionEntry, getCollection, render } from 'astro:content'
import PostLayout from '@/layouts/PostLayout.astro'
import { isPublishedPost } from '@/utils/posts'

export async function getStaticPaths() {
  const posts = await getCollection('posts', isPublishedPost)
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post
  }))
}

type Props = CollectionEntry<'posts'>

const post = Astro.props
const { Content, remarkPluginFrontmatter } = await render(post)

const readingTime = remarkPluginFrontmatter.readingTime
const toc = remarkPluginFrontmatter.toc || []
const contentFeatures = remarkPluginFrontmatter.contentFeatures || {}
---

<PostLayout {...post.data} readingTime={readingTime} toc={toc} contentFeatures={contentFeatures}>
  <Content />
</PostLayout>
