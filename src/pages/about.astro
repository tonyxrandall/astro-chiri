---
import { getEntry } from 'astro:content'
import IndexLayout from '@/layouts/IndexLayout.astro'
import AboutPageContent from '@/components/widgets/AboutPageContent.astro'
import { themeConfig } from '@/config'

const aboutPage = await getEntry('pages', 'about')
const title = aboutPage?.data.title ? `${aboutPage.data.title} — ${themeConfig.site.title}` : `About — ${themeConfig.site.title}`
const description = aboutPage?.data.description ?? themeConfig.site.description
---

<IndexLayout title={title} description={description}>
  {aboutPage && <AboutPageContent page={aboutPage} />}
</IndexLayout>
