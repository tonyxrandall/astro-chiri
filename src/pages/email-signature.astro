---
import GoogleAnalytics from '@/components/layout/GoogleAnalytics.astro'

const logo = '/images/b-side-logo.png'
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <GoogleAnalytics />

    <title>Email Signature</title>

    <style>
      body {
        margin: 0;
        padding: 40px;
        background: #efefef;
        font-family: Arial, Helvetica, sans-serif;
      }

      .signature-wrapper {
        background: white;
        width: fit-content;
        padding: 28px 36px;
      }

      table {
        border-collapse: collapse;
      }

      .logo-cell {
        padding-right: 28px;
        vertical-align: middle;
      }

      .info-cell {
        border-left: 2px solid #999;
        padding-left: 28px;
        vertical-align: middle;
      }

      .name {
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 4px;
        color: #3a3a3a;
        margin-bottom: 18px;
      }

      .links {
        font-size: 12px;
        line-height: 1.8;
        color: #333;
      }

      .links a {
        color: #333;
        text-decoration: none;
      }

      .icon {
        display: inline-block;
        width: 18px;
      }
    </style>
  </head>

  <body>
    <div class="signature-wrapper">
      <table cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td class="logo-cell">
            <img src={logo} alt="The B-Side" width="95" />
          </td>

          <td class="info-cell">
            <div class="name">ANTHONY PALOMAREZ</div>

            <div class="links">
              <div>
                <span class="icon">𝕏</span>
                <a href="https://x.com/tonyxrandall"> x.com/tonyxrandall </a>
              </div>

              <div>
                <span class="icon">in</span>
                <a href="https://linkedin.com/in/anthonypalomarez"> linkedin.com/in/anthonypalomarez </a>
              </div>

              <div>
                <span class="icon">◎</span>
                <a href="https://the-b-side.co"> the-b-side.co </a>
              </div>
            </div>
          </td>
        </tr>
      </table>
    </div>
  </body>
</html>
