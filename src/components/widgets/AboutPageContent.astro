---
import type { CollectionEntry } from 'astro:content'
import { renderMarkdown } from '@/utils/markdown'

type Page = CollectionEntry<'pages'>
const { page } = Astro.props as { page: Page }
const { hero, contact } = page.data
const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? ''
---

<div class="about-page prose">
  {
    hero && (
      <section class="about-hero">
        {hero.eyebrow && <p class="eyebrow">{hero.eyebrow}</p>}
        <h1>{hero.heading}</h1>
        {hero.body && <div set:html={renderMarkdown(hero.body)} />}
        {hero.image && <img src={hero.image} alt={hero.imageAlt ?? hero.heading} />}
      </section>
    )
  }

  {
    contact && (
      <section id="contact" class="contact-section">
        <h2>{contact.heading}</h2>
        <p>{contact.subtext}</p>
        <form name="contact" method="POST" action="https://api.web3forms.com/submit">
          <input type="hidden" name="access_key" value={web3formsAccessKey} />
          <input type="hidden" name="subject" value="New contact form submission from The B-Side" />
          <input type="hidden" name="from_name" value="The B-Side Contact Form" />
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required placeholder="Your name" />
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required placeholder="your@email.com" />
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required placeholder="Tell us about your project..." />
          <button type="submit">Send message</button>
        </form>
      </section>
    )
  }
</div>

<style>
  .eyebrow {
    color: var(--text-secondary);
    font-size: var(--font-size-s);
    margin-bottom: 0.25rem;
  }

  .about-hero img {
    border-radius: 0.75rem;
    display: block;
    margin: 1.5rem 0;
    max-width: 100%;
  }

  .contact-section {
    border-top: 1px solid var(--border);
    margin-top: 3rem;
    padding-top: 2rem;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  label {
    color: var(--text-secondary);
    font-size: var(--font-size-s);
  }

  input,
  textarea {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    box-sizing: border-box;
    color: var(--text-primary);
    font: inherit;
    padding: 0.625rem 0.75rem;
    width: 100%;
  }

  button {
    align-self: flex-start;
    background: var(--text-primary);
    border: 0;
    border-radius: 999px;
    color: var(--bg);
    cursor: pointer;
    font: inherit;
    margin-top: 0.5rem;
    padding: 0.625rem 1rem;
  }

  .hidden {
    display: none;
  }
</style>
