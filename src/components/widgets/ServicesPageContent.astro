---
import type { CollectionEntry } from 'astro:content'
import { renderMarkdown } from '@/utils/markdown'

type Page = CollectionEntry<'pages'>
const { page } = Astro.props as { page: Page }
const { hero, featureSplits = [], services, cta } = page.data
---

<div class="services-page prose">
  {
    hero && (
      <section class="services-hero">
        {hero.eyebrow && <p class="eyebrow">{hero.eyebrow}</p>}
        <h1>{hero.heading}</h1>
        {hero.subtext && <p>{hero.subtext}</p>}
      </section>
    )
  }

  {
    featureSplits.length > 0 && (
      <section class="card-grid process-grid" aria-label="Linkbuilding process">
        {featureSplits.map((feature) => (
          <article class="service-card process-card">
            {feature.eyebrow && <p class="eyebrow">{feature.eyebrow}</p>}
            <h2>{feature.heading}</h2>
            <p>{feature.subtext}</p>
          </article>
        ))}
      </section>
    )
  }

  {
    services && (
      <section class="services-section" aria-labelledby="services-heading">
        {services.eyebrow && <p class="eyebrow">{services.eyebrow}</p>}
        {services.heading.trim() && <h2 id="services-heading">{services.heading}</h2>}
        {services.subtext.trim() && <p>{services.subtext}</p>}
        <div class="card-grid service-list">
          {services.items.map((item) => (
            <article class="service-card">
              <h3>{item.title}</h3>
              <div set:html={renderMarkdown(item.description)} />
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    cta && (
      <section class="service-card cta-section">
        <h2>{cta.heading}</h2>
        <p>{cta.subtext}</p>
        {(cta.primaryButtonText || cta.secondaryButtonText) && (
          <div class="actions">
            {cta.primaryButtonText && cta.primaryButtonLink && (
              <a href={cta.primaryButtonLink}>{cta.primaryButtonText}</a>
            )}
            {cta.secondaryButtonText && cta.secondaryButtonLink && (
              <a href={cta.secondaryButtonLink}>{cta.secondaryButtonText}</a>
            )}
          </div>
        )}
      </section>
    )
  }
</div>

<style>
  .services-page {
    margin-bottom: 2rem;
  }

  .services-hero {
    margin-bottom: 2rem;
  }

  .eyebrow {
    color: var(--text-secondary);
    font-size: var(--font-size-s);
    margin-bottom: 0.25rem;
  }

  .card-grid {
    display: grid;
    gap: 1rem;
    margin: 2rem 0 3rem;
  }

  .process-grid,
  .service-list {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .services-section {
    margin: 3rem 0;
  }

  .service-list {
    margin-top: 1.25rem;
  }

  .service-card {
    background: color-mix(in srgb, var(--text-primary) 3%, transparent);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.25rem;
  }

  .service-card > :first-child {
    margin-top: 0;
  }

  .service-card > :last-child {
    margin-bottom: 0;
  }

  .service-card h2,
  .service-card h3 {
    margin-top: 0.8rem;
  }

  .process-card h2 {
    margin-top: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .actions a {
    color: var(--text-primary);
  }
</style>
