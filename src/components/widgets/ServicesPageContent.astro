---
import type { CollectionEntry } from 'astro:content'
import { renderMarkdown } from '@/utils/markdown'

type Page = CollectionEntry<'pages'>
const { page } = Astro.props as { page: Page }
const { hero, featureSplits = [], services, cta } = page.data

const serviceIconPaths = {
  chart: ['M6.5 18.5v-5', 'M12 18.5v-10', 'M17.5 18.5v-7', 'M5 18.5h14', 'M5.5 13.5h2', 'M11 8.5h2', 'M16.5 11.5h2'],
  heart: ['M12 19.5s-7-4.35-7-9.1A4.1 4.1 0 0 1 12 7.55a4.1 4.1 0 0 1 7 2.85c0 4.75-7 9.1-7 9.1Z'],
  link: [
    'M9.7 14.3 14.3 9.7',
    'M10.8 6.8l1.05-1.05a4 4 0 0 1 5.65 5.65l-1.55 1.55a4 4 0 0 1-5.65 0',
    'M13.2 17.2l-1.05 1.05a4 4 0 0 1-5.65-5.65l1.55-1.55a4 4 0 0 1 5.65 0'
  ],
  'map-pin': [
    'M12 20.5s6-5.3 6-10.2a6 6 0 0 0-12 0c0 4.9 6 10.2 6 10.2Z',
    'M12 12.5a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Z'
  ],
  megaphone: ['M5.5 13.5h2.75L16.5 17V7l-8.25 3.5H5.5v3Z', 'M8.5 13.75l1 4.25h2', 'M18 10.25a3 3 0 0 1 0 3.5'],
  wrench: [
    'M14.25 6.25a4.75 4.75 0 0 0 5.25 6.45l-6.8 6.8a2.05 2.05 0 0 1-2.9-2.9l6.8-6.8a4.75 4.75 0 0 0-6.45-5.25',
    'M5.75 18.25l.01.01'
  ]
}

const getServiceIconPaths = (icon?: string) =>
  serviceIconPaths[(icon ?? 'link') as keyof typeof serviceIconPaths] ?? serviceIconPaths.link
---

<div class="services-page prose">
  {
    hero && (
      <section class="services-hero">
        {hero.eyebrow && <p class="eyebrow">{hero.eyebrow}</p>}
        <h1>{hero.heading}</h1>
        {hero.subtext && <p>{hero.subtext}</p>}
      </section>
    )
  }

  {
    featureSplits.length > 0 && (
      <section class="card-grid process-grid" aria-label="Linkbuilding process">
        {featureSplits.map((feature) => (
          <article class="service-card process-card">
            {feature.eyebrow && <p class="eyebrow">{feature.eyebrow}</p>}
            <h2>{feature.heading}</h2>
            <p>{feature.subtext}</p>
          </article>
        ))}
      </section>
    )
  }

  {
    services && (
      <section class="services-section" aria-labelledby="services-heading">
        {services.eyebrow && <p class="eyebrow">{services.eyebrow}</p>}
        {services.heading.trim() && <h2 id="services-heading">{services.heading}</h2>}
        {services.subtext.trim() && <p>{services.subtext}</p>}
        <div class="card-grid service-list">
          {services.items.map((item) => (
            <article class="service-card">
              <h3>{item.title}</h3>
              <div set:html={renderMarkdown(item.description)} />
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    cta && (
      <section class="service-card cta-section">
        <h2>{cta.heading}</h2>
        <p>{cta.subtext}</p>
        {(cta.primaryButtonText || cta.secondaryButtonText) && (
          <div class="actions">
            {cta.primaryButtonText && cta.primaryButtonLink && (
              <a href={cta.primaryButtonLink}>{cta.primaryButtonText}</a>
            )}
            {cta.secondaryButtonText && cta.secondaryButtonLink && (
              <a href={cta.secondaryButtonLink}>{cta.secondaryButtonText}</a>
            )}
          </div>
        )}
      </section>
    )
  }
</div>

<style>
  .services-page {
    margin-bottom: 2rem;
  }

  .services-hero {
    margin-bottom: 2rem;
  }

  .eyebrow {
    color: var(--text-secondary);
    font-size: var(--font-size-s);
    margin-bottom: 0.25rem;
  }

  .card-grid {
    display: grid;
    gap: 1rem;
    margin: 2rem 0 3rem;
  }

  .process-grid,
  .service-list {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .services-section {
    margin: 3rem 0;
  }

  .service-list {
    margin-top: 1.25rem;
  }

  .service-card {
    background: color-mix(in srgb, var(--text-primary) 3%, transparent);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.25rem;
  }

  .service-card > :first-child {
    margin-top: 0;
  }

  .service-card > :last-child {
    margin-bottom: 0;
  }

  .service-card h2,
  .service-card h3 {
    margin-top: 0.8rem;
  }

  .process-card h2 {
    margin-top: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .actions a {
    color: var(--text-primary);
  }
</style>
