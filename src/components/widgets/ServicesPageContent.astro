---
import type { CollectionEntry } from 'astro:content'
import { renderMarkdown } from '@/utils/markdown'

type Page = CollectionEntry<'pages'>
const { page } = Astro.props as { page: Page }
const { hero, featureSplits = [], services, cta } = page.data

const serviceIconPaths = {
  chart: 'M3 10.5h2.25V19H3v-8.5Zm5.125-4h2.25V19h-2.25V6.5Zm5.125 3h2.25V19h-2.25V9.5Zm5.125-6H20.5V19h-2.125V3.5Z',
  heart:
    'M12 20.5c-.25 0-.5-.08-.7-.25C5.1 15.1 2 11.55 2 7.8 2 4.75 4.35 2.5 7.15 2.5c1.65 0 3.25.78 4.25 2.03A5.6 5.6 0 0 1 15.75 2.5C18.6 2.5 21.9 4.72 21.9 7.8c0 3.75-3.1 7.3-9.3 12.45-.18.17-.38.25-.6.25Z',
  link: 'M8.65 12.95a1 1 0 0 1 0-1.4l2.9-2.9a1 1 0 1 1 1.4 1.4l-2.9 2.9a1 1 0 0 1-1.4 0ZM7.8 17.3a4.25 4.25 0 0 1-3-7.25l3.15-3.15a4.25 4.25 0 0 1 6.62.8 1 1 0 0 1-1.72 1.02 2.25 2.25 0 0 0-3.54-.3L6.22 11.5a2.25 2.25 0 0 0 3.18 3.18l1.1-1.1a1 1 0 1 1 1.4 1.42l-1.1 1.1a4.22 4.22 0 0 1-3 1.25Zm6.2-4.25a1 1 0 0 1 .35-1.37 2.25 2.25 0 0 0 .33-3.55 2.25 2.25 0 0 0-3.18 0l-1.1 1.1a1 1 0 1 1-1.4-1.4l1.1-1.1a4.25 4.25 0 0 1 6 6 4.5 4.5 0 0 1-1.02.75 1 1 0 0 1-1.08-.43Z',
  'map-pin': 'M12 22s7-5.7 7-12.2A7 7 0 0 0 5 9.8C5 16.3 12 22 12 22Zm0-9.2a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z',
  megaphone:
    'M3 10.25v3.5a2 2 0 0 0 2 2h1.15l1.18 4.02c.16.54.65.91 1.21.91h1.24a1 1 0 0 0 .96-1.28l-1.08-3.65H11l7 3.25V4l-7 3.25H5a2 2 0 0 0-2 2Zm15.75 1.75c0-1.2.8-2.2 1.9-2.5v5c-1.1-.3-1.9-1.3-1.9-2.5Z',
  wrench:
    'M21.1 6.2a6.25 6.25 0 0 1-7.8 7.8L7.1 20.2a2.6 2.6 0 0 1-3.7-3.7l6.2-6.2a6.25 6.25 0 0 1 7.8-7.8l-3.65 3.65 2.6 2.6L21.1 6.2Z'
}

const processIcons = ['chart', 'wrench', 'megaphone', 'link']
const getServiceIconPath = (icon?: string) =>
  serviceIconPaths[(icon ?? 'link') as keyof typeof serviceIconPaths] ?? serviceIconPaths.link
const getProcessIconPath = (index: number) =>
  serviceIconPaths[processIcons[index % processIcons.length] as keyof typeof serviceIconPaths]
---

<div class="services-page prose">
  {
    hero && (
      <section class="services-hero">
        {hero.eyebrow && <p class="eyebrow">{hero.eyebrow}</p>}
        <h1>{hero.heading}</h1>
        {hero.subtext && <p>{hero.subtext}</p>}
      </section>
    )
  }

  {
    featureSplits.length > 0 && (
      <section class="card-grid process-grid" aria-label="Linkbuilding process">
        {featureSplits.map((feature, index) => (
          <article class="service-card process-card">
            <span class="service-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" role="img">
                <path d={getProcessIconPath(index)} />
              </svg>
            </span>
            {feature.eyebrow && <p class="eyebrow">{feature.eyebrow}</p>}
            <h2>{feature.heading}</h2>
            <p>{feature.subtext}</p>
          </article>
        ))}
      </section>
    )
  }

  {
    services && (
      <section class="services-section" aria-labelledby="services-heading">
        {services.eyebrow && <p class="eyebrow">{services.eyebrow}</p>}
        {services.heading.trim() && <h2 id="services-heading">{services.heading}</h2>}
        {services.subtext.trim() && <p>{services.subtext}</p>}
        <div class="card-grid service-list">
          {services.items.map((item) => (
            <article class="service-card">
              <span class="service-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img">
                  <path d={getServiceIconPath(item.icon)} />
                </svg>
              </span>
              <h3>{item.title}</h3>
              <div set:html={renderMarkdown(item.description)} />
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    cta && (
      <section class="service-card cta-section">
        <h2>{cta.heading}</h2>
        <p>{cta.subtext}</p>
        {(cta.primaryButtonText || cta.secondaryButtonText) && (
          <div class="actions">
            {cta.primaryButtonText && cta.primaryButtonLink && (
              <a href={cta.primaryButtonLink}>{cta.primaryButtonText}</a>
            )}
            {cta.secondaryButtonText && cta.secondaryButtonLink && (
              <a href={cta.secondaryButtonLink}>{cta.secondaryButtonText}</a>
            )}
          </div>
        )}
      </section>
    )
  }
</div>

<style>
  .services-page {
    margin-bottom: 2rem;
  }

  .services-hero {
    margin-bottom: 2rem;
  }

  .eyebrow {
    color: var(--text-secondary);
    font-size: var(--font-size-s);
    margin-bottom: 0.25rem;
  }

  .card-grid {
    display: grid;
    gap: 1rem;
    margin: 2rem 0 3rem;
  }

  .process-grid,
  .service-list {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .services-section {
    margin: 3rem 0;
  }

  .service-list {
    margin-top: 1.25rem;
  }

  .service-card {
    background: color-mix(in srgb, var(--text-primary) 3%, transparent);
    border: 1px solid var(--border);
    border-radius: 1rem;
    box-shadow: 0 1rem 2.5rem color-mix(in srgb, var(--text-primary) 5%, transparent);
    padding: 1.25rem;
  }

  .service-card > :first-child {
    margin-top: 0;
  }

  .service-card > :last-child {
    margin-bottom: 0;
  }

  .service-card h2,
  .service-card h3 {
    margin-top: 0.8rem;
  }

  .service-icon {
    align-items: center;
    background: color-mix(in srgb, var(--text-primary) 8%, transparent);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-primary);
    display: inline-flex;
    height: 2.75rem;
    justify-content: center;
    width: 2.75rem;
  }

  .service-icon svg {
    display: block;
    fill: currentColor;
    height: 1.35rem;
    width: 1.35rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .actions a {
    color: var(--text-primary);
  }
</style>
