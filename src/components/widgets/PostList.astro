---
import FormattedDate from '@/components/widgets/FormattedDate.astro'
import type { PostListProps } from '@/types'
import { themeConfig } from '@/config'

const { posts } = Astro.props as PostListProps

const getCoverImage = (post: PostListProps['posts'][number]) => {
  const { image, title } = post.data

  if (!image) return undefined
  if (typeof image === 'string') return { url: image, alt: title }

  return {
    url: image.url,
    alt: image.alt ?? title
  }
}
---

<ul>
  {
    posts.map((post) => {
      const postUrl = `/blog/${post.id}/`
      const coverImage = getCoverImage(post)

      return (
        <li>
          <article class="post-card">
            <a class="post-title-link" href={postUrl}>
              <div class={`post-item ${!themeConfig.date.dateOnRight ? 'date-left' : ''}`}>
                {!themeConfig.date.dateOnRight && (
                  <p class="date font-features">
                    <FormattedDate date={post.data.pubDate} context="list" />
                  </p>
                )}
                <p class="title">{post.data.title}</p>
                {themeConfig.date.dateOnRight && (
                  <div class={themeConfig.general.postListDottedDivider ? 'dotted-divider' : 'divider'} />
                )}
                {themeConfig.date.dateOnRight && (
                  <p class="date font-features">
                    <FormattedDate date={post.data.pubDate} context="list" />
                  </p>
                )}
              </div>
            </a>
            {coverImage && (
              <a class="post-cover-link" href={postUrl} aria-label={`Read ${post.data.title}`}>
                <img class="post-cover" src={coverImage.url} alt={coverImage.alt} loading="lazy" />
              </a>
            )}
          </article>
        </li>
      )
    })
  }
</ul>
<div class="placeholder"></div>

<style>
  ul {
    padding: 0;
    margin: 0;
    list-style-type: none;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  a {
    color: var(--text-primary);
    display: block;
    text-decoration: none;
    transition: opacity 0.15s ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    ul:hover a {
      opacity: 0.4;
    }

    ul:hover a:hover,
    ul:hover .post-card:has(a:hover) a {
      opacity: 1;
    }

    ul:hover a:hover .divider,
    ul:hover .post-card:has(a:hover) .divider {
      background-color: var(--text-tertiary);
      opacity: 0.75;
    }
    ul:hover a:hover .dotted-divider,
    ul:hover .post-card:has(a:hover) .dotted-divider {
      color: var(--text-secondary);
    }
    ul:hover a:hover .date,
    ul:hover .post-card:has(a:hover) .date {
      color: var(--text-secondary);
      opacity: 1;
    }
  }

  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .post-item {
    min-height: 2.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .post-item.date-left {
    justify-content: flex-start;
  }

  .post-item.date-left .title {
    flex: 1 1 auto;
    min-width: 0;
  }

  .post-item.date-left .date {
    margin-right: 0.75rem;
  }

  .title {
    margin: 0;
    flex-shrink: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .date {
    margin: 0;
    color: var(--text-secondary);
    opacity: 0.75;
    letter-spacing: var(--spacing-s);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .divider {
    flex: 1 1 auto;
    min-width: 3rem;
    margin: 0 0.25rem;
    height: 0.5px;
    background-color: var(--border);
  }

  .dotted-divider {
    flex: 1 1 3rem;
    min-width: 3rem;
    max-width: 100%;
    text-align: end;
    letter-spacing: 5px;
    height: 1.675rem;
    overflow: hidden;
    color: var(--text-tertiary);
    opacity: 0.75;
  }

  .dotted-divider::after {
    content: '·····························································································································································';
    pointer-events: none;
  }

  .post-cover-link {
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .post-cover {
    border-radius: 0.75rem;
    display: block;
    width: 100%;
  }

  .placeholder {
    height: 3rem;
  }
</style>
